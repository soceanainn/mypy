[case testNestedProtocolGenericUnionsDeep]
from typing import TypeVar, Union, Iterator, List
T = TypeVar("T")
Iter = Union[Iterator[T], List[T]]
def foo(
    values: Iter[Iter[Iter[Iter[Iter[int]]]]],
) -> Iterator[int]:
    for i in values:
        for j in i:
            for k in j:
                for l in k:
                    for m in l:
                        yield m
foo([[[[[1]]]]])
