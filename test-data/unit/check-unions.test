-- Type checking of union types

[case testUnionOfManyNominalClassesNarrowing]
# Keep this case large enough to expose quadratic union narrowing.
# To time it, run with -n0 --durations=1 -k testUnionOfManyNominalClassesNarrowing.
from typing import Union

class Event:
